# --- Yakalama modu ---
# path = yerel/geliştirme: tek adres, {PANEL_BASE_URL}/c/{token}/...
# host = üretim/VPS: alt alan tabanlı, {token}.{BASE_DOMAIN}
CAPTURE_MODE=path

# --- Panel / API ---
# Paneli ve /api uçlarını koruyan tek admin token'ı. MUTLAKA değiştir.
ADMIN_TOKEN=degistir-beni-uzun-rastgele-bir-deger

# path modunda yakalama adreslerinin gösterileceği temel URL.
PANEL_BASE_URL=http://localhost:8000

# host modu (VPS) ayarları:
# Yakalama (HTTP + DNS) kök alanı. NS kaydı bu VPS'i göstermeli.
BASE_DOMAIN=oob.dagdelen.dev
# Panel ayrı origin'de yayınlanır.
PANEL_DOMAIN=panel.dagdelen.dev
# Gösterilen yakalama adresinin şeması (TLS yokken http, sertifika varken https).
CAPTURE_SCHEME=https
# DNS A sorgularında döndürülecek public IP (hedef HTTP için geri bağlanır).
PUBLIC_IP=203.0.113.10

MAX_BODY_BYTES=2097152

# --- DNS ---
DNS_UDP_PORT=53
DNS_TCP_PORT=53

# --- Depolama ---
DB_PATH=data/kanca.db

# Aynı token için gruplama penceresi (saniye).
GROUP_WINDOW_S=5.0
# Grup başına en fazla kaç etkileşime AI analizi yapılsın (fuzzing kota koruması).
AI_MAX_PER_GROUP=5

# --- Veri saklama (DB sınırsız büyümesin) ---
MAX_INTERACTIONS_PER_TOKEN=500
INTERACTION_TTL_DAYS=7
CLEANUP_INTERVAL_S=3600

# --- AI (OpenAI uyumlu; boş bırakılırsa AI kapalı) ---
# AI'ya gönderilen metinde cookie/token/secret maskelensin mi (ham kayıt değişmez).
# Hassas angajmanlarda true yap.
AI_REDACT=false
# Groq örneği: https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1 | Yerel Ollama: http://localhost:11434/v1
AI_BASE_URL=https://api.groq.com/openai/v1
# Model adını sağlayıcının GÜNCEL listesinden al (modeller kapanabilir).
# Groq (2026) ücretsiz örnek: openai/gpt-oss-20b (hızlı) veya openai/gpt-oss-120b
AI_MODEL=
AI_API_KEY=

# --- Telegram (boş bırakılırsa bildirim kapalı) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
